# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env nem coloque valores reais aqui.

# Conexão com o banco (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# JWT — gere um segredo longo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<gere-um-segredo-longo>

# URL do front (usada no link do e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:5173

# SMTP — e-mail para recuperar senha
# No Gmail, use uma "senha de app" (Conta Google → Segurança → Senhas de app), não a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<seu-email@gmail.com>
SMTP_PASS=<senha-de-app>
MAIL_FROM=<seu-email@gmail.com>

# Supabase Storage (upload de imagens) — Project Settings → API Keys
# A service_role/secret ignora as regras de acesso: só no backend, nunca no front.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_BUCKET=<nome-do-bucket>
