# Conexao com o Supabase (Session pooler - IPv4).
# Pegue a string em: Dashboard > Connect > Session pooler
# Use o pooler, nao db.<ref>.supabase.co: aquele host so responde em IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Segredo de assinatura dos JWT. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
